#!/usr/bin/env python3
# hier-nest
# Recursive nested compositor launcher and client orchestrator

import sys
import os
import subprocess
import re
import time
import json

def print_help():
    print("Usage: hier-nest <nest_level> [--cookie <id>] [--net <mode>] <command...>")
    print("Example: hier-nest 1 foot")
    print("Example: hier-nest 1 --cookie work foot")
    print("Example: hier-nest 1 --net none foot")
    sys.exit(1)

def main():
    if len(sys.argv) < 2:
        print_help()

    # Parse internal flag indicating we are already in the bubblewrap sandbox
    inside_sandbox = False
    args = sys.argv[1:]
    if args and args[0] == "--inside-sandbox":
        inside_sandbox = True
        args = args[1:]

    if len(args) < 2:
        print_help()

    try:
        nest_level = int(args[0])
    except ValueError:
        print("Error: nest_level must be an integer.")
        print_help()

    # Parse optional arguments
    cookie_id = None
    net_mode = None
    net_param = None
    remaining_args = args[1:]
    
    idx = 0
    while idx < len(remaining_args):
        if remaining_args[idx] == "--cookie":
            if idx + 1 < len(remaining_args):
                cookie_id = remaining_args[idx+1]
                idx += 2
            else:
                print("Error: --cookie requires a value.")
                print_help()
        elif remaining_args[idx] == "--net":
            if idx + 1 < len(remaining_args):
                net_mode = remaining_args[idx+1]
                if net_mode in ("vpn", "proxy"):
                    if idx + 2 < len(remaining_args):
                        net_param = remaining_args[idx+2]
                        idx += 3
                    else:
                        print(f"Error: --net {net_mode} requires a parameter.")
                        print_help()
                else:
                    net_param = None
                    idx += 2
            else:
                print("Error: --net requires a value.")
                print_help()
        else:
            break

    command_args = remaining_args[idx:]
    if not command_args:
        print("Error: No command specified to run inside the nest.")
        print_help()

    # Resolve paths
    exe_dir = os.path.dirname(os.path.realpath(__file__))
    sandbox_script = os.path.join(exe_dir, "sandbox_run.sh")

    # If we are not inside the sandbox yet, wrap the entire execution in sandbox_run.sh
    if not inside_sandbox and os.path.exists(sandbox_script):
        sandbox_cmd = [sandbox_script]
        if cookie_id:
            sandbox_cmd += ["--cookie", cookie_id]
        if net_mode:
            sandbox_cmd += ["--net", net_mode]
            if net_param:
                sandbox_cmd += [net_param]
            
        nested_run_args = [sys.executable, "/app/hier-nest", "--inside-sandbox", str(nest_level)]
        if cookie_id:
            nested_run_args += ["--cookie", cookie_id]
        if net_mode:
            nested_run_args += ["--net", net_mode]
            if net_param:
                nested_run_args += [net_param]
        nested_run_args += command_args
        
        full_cmd = sandbox_cmd + nested_run_args
        print(f"[*] Re-executing hier-nest inside Bubblewrap sandbox:")
        print(f"    {' '.join(full_cmd)}")
        
        # Detect host active output transform before sandboxing
        host_transform = "Normal"
        try:
            res_ws = subprocess.check_output(["niri", "msg", "--json", "workspaces"]).decode()
            workspaces = json.loads(res_ws)
            active_output = None
            for ws in workspaces:
                if ws.get("is_focused") or ws.get("is_active"):
                    active_output = ws.get("output")
                    if ws.get("is_focused"):
                        break
            if active_output:
                res_outs = subprocess.check_output(["niri", "msg", "--json", "outputs"]).decode()
                outputs = json.loads(res_outs)
                output_info = outputs.get(active_output)
                if output_info:
                    host_transform = output_info["logical"].get("transform", "Normal")
        except Exception:
            pass

        env = os.environ.copy()
        env["HIER_HOST_TRANSFORM"] = host_transform
        if cookie_id:
            env["HIER_COOKIE"] = cookie_id
            
        try:
            res = subprocess.run(full_cmd, env=env)
            sys.exit(res.returncode)
        except Exception as e:
            print(f"❌ Error re-executing inside sandbox: {e}")
            sys.exit(1)

    # Resolve parent display.
    # Use the active WAYLAND_DISPLAY environment variable if present.
    # Otherwise fallback to wayland-{nest_level}.
    parent_display = os.environ.get("WAYLAND_DISPLAY")
    if not parent_display:
        parent_display = f"wayland-{nest_level}"
    print(f"[*] Launching nested compositor (Nest {nest_level}) inside parent display: {parent_display}")

    # Build environment for the child compositor
    comp_env = os.environ.copy()
    comp_env["WAYLAND_DISPLAY"] = parent_display
    if cookie_id:
        comp_env["HIER_COOKIE"] = cookie_id

    # Path to the compositor binary
    comp_bin = os.path.join(exe_dir, "target/debug/hier")
    if not os.path.exists(comp_bin):
        comp_bin = "hier"  # Fallback to system path

    # Spawn the nested compositor, capturing stdout to read the allocated socket name
    print(f"[*] Executing child compositor: {comp_bin}")
    try:
        proc = subprocess.Popen(
            [comp_bin],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            env=comp_env,
            text=True
        )
    except Exception as e:
        print(f"❌ Error: Failed to spawn compositor process: {e}")
        sys.exit(1)

    child_display = None
    # Read stdout line-by-line to parse the WAYLAND_DISPLAY line
    start_time = time.time()
    while True:
        if time.time() - start_time > 10.0:
            print("❌ Error: Timeout waiting for nested compositor socket initialization.")
            proc.terminate()
            sys.exit(1)

        line = proc.stdout.readline()
        if not line:
            # Check if process terminated early
            ret = proc.poll()
            if ret is not None:
                print(f"❌ Error: Compositor exited early with code {ret}")
                sys.exit(1)
            time.sleep(0.05)
            continue

        print(f"[Compositor Output] {line.strip()}")
        # Match "WAYLAND_DISPLAY=wayland-X"
        match = re.search(r"WAYLAND_DISPLAY=(wayland-\d+)", line)
        if match:
            child_display = match.group(1)
            print(f"✅ Nested compositor successfully initialized child display: {child_display}")
            break

    # Make stdout non-blocking so we don't hang, and let it run in the background
    os.set_blocking(proc.stdout.fileno(), False)

    # Spawn the target client program inside the child display
    print(f"[*] Spawning client app: {' '.join(command_args)} under display: {child_display}")
    
    # Setup environment for the client
    client_env = os.environ.copy()
    client_env["WAYLAND_DISPLAY"] = child_display
    if cookie_id:
        client_env["HIER_COOKIE"] = cookie_id

    # Since we are already inside the sandbox container, we execute the client directly.
    client_cmd = command_args

    try:
        client_proc = subprocess.Popen(
            client_cmd,
            env=client_env
        )
        print(f"✅ Client spawned successfully (PID: {client_proc.pid})")
    except Exception as e:
        print(f"❌ Error: Failed to spawn client program: {e}")
        proc.terminate()
        sys.exit(1)

    # Wait for the client to exit, then terminate the child compositor
    try:
        client_proc.wait()
        print("[*] Client program exited. Terminating nested compositor...")
    except KeyboardInterrupt:
        print("[*] KeyboardInterrupt received. Cleaning up processes...")
        client_proc.terminate()
    
    proc.terminate()
    print("[*] Cleanup complete.")

if __name__ == "__main__":
    main()

