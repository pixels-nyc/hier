#!/usr/bin/env python3
# hier-tree
# Inspects and prints the recursive nesting display hierarchy tree ("Tree of Trees")

import os
import sys
import re

def get_inode_to_socket_map():
    """Parses /proc/net/unix to map socket inodes to wayland displays."""
    inode_to_socket = {}
    try:
        with open("/proc/net/unix", "r") as f:
            lines = f.readlines()
    except Exception as e:
        print(f"Error reading /proc/net/unix: {e}")
        return inode_to_socket

    for line in lines[1:]:
        parts = line.strip().split()
        if len(parts) >= 8:
            inode = parts[6]
            path = parts[7]
            # Check if path is a wayland display socket
            match = re.search(r"wayland-\d+$", path)
            if match:
                inode_to_socket[inode] = match.group(0)
    return inode_to_socket

def get_process_info(inode_to_socket):
    """Scans /proc to extract process details, parent sockets, and owned sockets."""
    processes = {}
    
    # List all PIDs in /proc
    pids = [d for d in os.listdir("/proc") if d.isdigit()]
    
    for pid_str in pids:
        pid = int(pid_str)
        proc_dir = f"/proc/{pid}"
        
        try:
            # Get process name
            with open(f"{proc_dir}/comm", "r") as f:
                name = f.read().strip()
        except IOError:
            continue  # Process exited or permission denied

        # Skip common system daemons to keep tree clean
        if name in ("systemd", "dbus-daemon", "dbus-broker", "pipewire", "wireplumber"):
            continue

        # Get parent display from environment
        parent_display = None
        try:
            with open(f"{proc_dir}/environ", "rb") as f:
                environ_bytes = f.read()
            environ_strs = environ_bytes.decode("utf-8", errors="ignore").split("\x00")
            for entry in environ_strs:
                if entry.startswith("WAYLAND_DISPLAY="):
                    parent_display = entry.split("=", 1)[1]
                    break
        except Exception:
            pass

        # Get owned display socket (if this process acts as a Wayland server)
        owned_displays = []
        try:
            fd_dir = f"{proc_dir}/fd"
            for fd in os.listdir(fd_dir):
                fd_path = f"{fd_dir}/{fd}"
                try:
                    target = os.readlink(fd_path)
                    match = re.match(r"socket:\[(\d+)\]", target)
                    if match:
                        inode = match.group(1)
                        if inode in inode_to_socket:
                            display = inode_to_socket[inode]
                            if display not in owned_displays:
                                owned_displays.append(display)
                except Exception:
                    pass
        except Exception:
            pass

        processes[pid] = {
            "pid": pid,
            "name": name,
            "parent_display": parent_display,
            "owned_displays": owned_displays,
            "children_displays": []
        }
    
    return processes

def build_hierarchy():
    inode_map = get_inode_to_socket_map()
    procs = get_process_info(inode_map)
    
    # A display can map to an owner process (e.g. wayland-2 owned by hier PID 123)
    display_owners = {}
    for pid, info in procs.items():
        for d in info["owned_displays"]:
            display_owners[d] = pid

    # Build associations:
    # A client is associated with a display if WAYLAND_DISPLAY matches
    display_clients = {}
    for pid, info in procs.items():
        p_display = info["parent_display"]
        if p_display:
            display_clients.setdefault(p_display, []).append(pid)

    return procs, display_owners, display_clients

def print_tree(procs, display_owners, display_clients):
    print("==================================================")
    print("      WAYLAND NESTING DISPLAY HIERARCHY TREE      ")
    print("==================================================")
    
    # We find all displays that have clients, but no known owner (root displays like wayland-1)
    all_displays = set(display_clients.keys()) | set(display_owners.keys())
    root_displays = sorted(list(all_displays - set(display_owners.keys())))
    
    if not root_displays and all_displays:
        # Fallback if everything has an owner, start from wayland-1
        root_displays = ["wayland-1"]

    for root_d in root_displays:
        print_display_node(root_d, "", True, procs, display_owners, display_clients)

def print_display_node(display, prefix, is_last, procs, display_owners, display_clients):
    owner_pid = display_owners.get(display)
    owner_info = f" (owned by PID {owner_pid}: {procs[owner_pid]['name']})" if owner_pid else " (Host Display)"
    
    print(f"{prefix}{'└── ' if is_last else '├── '}[{display}]{owner_info}")
    
    clients = display_clients.get(display, [])
    # Filter out the owner of the child displays from the direct client list
    # so they are represented as nested displays under this node instead of flat clients
    child_display_procs = []
    flat_clients = []
    
    for c_pid in clients:
        c_info = procs.get(c_pid)
        if c_info and c_info["owned_displays"]:
            child_display_procs.append(c_pid)
        else:
            flat_clients.append(c_pid)
            
    child_prefix = prefix + ("    " if is_last else "│   ")
    
    # Print flat clients
    for idx, c_pid in enumerate(flat_clients):
        c_is_last = (idx == len(flat_clients) - 1) and (len(child_display_procs) == 0)
        c_name = procs[c_pid]["name"]
        print(f"{child_prefix}{'└── ' if c_is_last else '├── '}Process PID {c_pid}: {c_name}")
        
    # Print nested displays (owned by processes connected as clients to this display)
    for idx, c_pid in enumerate(child_display_procs):
        c_is_last = (idx == len(child_display_procs) - 1)
        # Find which displays this child process owns
        for owned_d in procs[c_pid]["owned_displays"]:
            print_display_node(owned_d, child_prefix, c_is_last, procs, display_owners, display_clients)

if __name__ == "__main__":
    procs, display_owners, display_clients = build_hierarchy()
    print_tree(procs, display_owners, display_clients)
